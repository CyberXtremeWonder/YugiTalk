# 复制为 .env.production 后逐项填写；不要复用开发凭证，不提交真实密钥。
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# 服务方凭证；有特殊字符时使用单引号保存字面值，不使用变量占位。
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# 项目专用的现有S3服务，HTTPS地址和主机/端口必须一致；Bucket由运维预先创建。
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
# 默认path；要求虚拟主机地址的服务改为virtual，并确认Bucket DNS与证书匹配。
STORAGE_ADDRESSING_STYLE=path
# 私有CA：填写宿主PEM路径，并设置STORAGE_CA_FILE=/etc/yugitalk/s3/ca.pem。
S3_CA_SOURCE=
STORAGE_CA_FILE=
S3_HOST=
S3_PORT=443
S3_USE_SSL=true
MILVUS_STORAGE_BUCKET=
MILVUS_STORAGE_PREFIX=yugitalk-milvus
MILVUS_PASSWORD=
SESSION_SECRET=
METRICS_TOKEN=
MODEL_PROVIDER=openai_compatible
MODEL_ID=
MODEL_BASE_URL=
MODEL_API_KEY=
# 与开发环境一致，协议容量不等于正文长度或 Token 额度。
MODEL_MAX_STREAM_BYTES=4194304
TOOL_HTTP_ALLOWED_HOSTS=["api.tavily.com"]
# 邮箱验证码注册；凭证仅保存在私有环境文件，SMTP_TLS支持ssl或starttls。
REGISTRATION_ENABLED=true
SMTP_HOST=
SMTP_PORT=465
SMTP_TLS=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
# JSON 对象：引用名称到密钥值；只保存在服务器私有环境配置，不通过前端提交。
TOOL_SECRETS={}
# 高德 Web 服务 Key：仅在服务端私有环境文件填写，工具页面不保存真实密钥
AMAP_API_KEY=
# 企业自签模型证书可设置容器内 CA 文件路径，并通过单独覆盖文件只读挂载。
MODEL_CA_FILE=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BASE_URL=http://embedding:8000/v1
EMBEDDING_API_KEY=
BGE_MODEL_PATH=./.cache/models/models--BAAI--bge-m3
COMPOSE_PROFILES=local-embedding
PUBLIC_ORIGIN=https://agent.example.com
PROD_DATA_ROOT=data/production
HTTPS_BIND_ADDRESS=0.0.0.0
HTTPS_PORT=443
HTTP_PORT=80
OTEL_SAMPLE_RATIO=0.1
BACKEND_IMAGE=yugitalk-backend:0.2.0
FRONTEND_IMAGE=yugitalk-frontend:0.2.0
# 默认不限制对话 Token 额度；仍统计用量并限制并发、超时与工具调用。
CUMULATIVE_BUDGET_ENABLED=false
TASK_BUDGET_ENABLED=false
# 文件索引独立执行时限（秒），范围 60～7200。
DOCUMENT_INDEX_TIMEOUT_SECONDS=1800
WORKSPACE_TOKEN_BUDGET=100000
USER_TOKEN_BUDGET=100000
WORKSPACE_CONCURRENCY=4
USER_CONCURRENCY=2

# 七步 RAG；Fast 留空用本地规则，Grader 留空沿用当前回答模型。
# Rerank 端点填写完整 /rerank 地址，默认关闭；生产端点要求 HTTPS。
RAG_TIMEOUT_SECONDS=60
RAG_PARALLEL_QUERIES=4
RAG_FAST_MODEL=
RAG_FAST_API_KEY=
# 图谱独立后台抽取，复用 Fast 模型或默认聊天模型；关闭后保留普通 RAG。
RAG_GRAPH_ENABLED=true
RAG_GRADER_MODEL=
RAG_GRADER_API_KEY=
RAG_CANDIDATE_LIMIT=24
RAG_CONTEXT_CHARACTERS=5000
RAG_MERGE_RATIO=0.5
RAG_HITL_TTL_SECONDS=1800
RAG_RERANK_URL=
RAG_RERANK_MODEL=
RAG_RERANK_API_KEY=
RAG_RERANK_TIMEOUT_SECONDS=3
RAG_RERANK_MAX_CHARACTERS=12000
RAG_RERANK_FAILURE_THRESHOLD=3
RAG_RERANK_COOLDOWN_SECONDS=30

# Tavily 网页搜索服务端密钥；同时在 TOOL_HTTP_ALLOWED_HOSTS 加入 api.tavily.com
TAVILY_API_KEY=
