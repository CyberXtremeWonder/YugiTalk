# 仅用于本地开发；复制为 .env 后可覆盖配置，真实密钥不要提交仓库。
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# Docker API 宿主端口，与本机 API 分开；容器内部仍使用 8000。
API_BIND_PORT=18000
APP_RELOAD=false
DATABASE_URL=postgresql://yugitalk:dev-database-only@127.0.0.1:25432/yugitalk
REDIS_URL=redis://127.0.0.1:26379/0
STORAGE_ENDPOINT=http://127.0.0.1:29000
STORAGE_ACCESS_KEY=dev-storage-user
STORAGE_SECRET_KEY=dev-storage-password
STORAGE_BUCKET=yugitalk
# 开发 Milvus 不启用认证；生产必须配置独立认证令牌。
MILVUS_URI=http://127.0.0.1:29530
MILVUS_TOKEN=
MILVUS_DATABASE=default
# 此项填写协议类型：mock / openai_compatible / anthropic；DeepSeek 使用 openai_compatible。
MODEL_PROVIDER=mock
MODEL_ID=mock-v1
MODEL_API_KEY=
# 完整协议前缀，例如 https://供应商域名/v1；仅后端读取，禁止放入 VITE_*。
MODEL_BASE_URL=
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2
# SSE 整体协议容量默认 4 MiB；单帧、可见正文和工具参数仍分别限制为 64 KiB。
MODEL_MAX_STREAM_BYTES=4194304
# 自定义只读 HTTP Tool：明确允许公共域名；密钥引用值仅填写本地私有环境文件。
TOOL_HTTP_ALLOWED_HOSTS=["api.tavily.com"]
# 邮箱验证码注册：未填写SMTP时不发送验证码，也不开放验证通过的替身。
REGISTRATION_ENABLED=true
SMTP_HOST=
SMTP_PORT=465
SMTP_TLS=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
TOOL_SECRETS={}
# 高德 Web 服务 Key：仅在服务端私有环境文件填写，工具页面不保存真实密钥
AMAP_API_KEY=
# 全局累计保守额度与并发；不是供应商账单，不自动按日重置。
# 默认关闭累计和单次 Token 额度拦截；开发与生产均保留用量统计。
CUMULATIVE_BUDGET_ENABLED=false
TASK_BUDGET_ENABLED=false
WORKSPACE_TOKEN_BUDGET=100000
USER_TOKEN_BUDGET=100000
WORKSPACE_CONCURRENCY=4
USER_CONCURRENCY=2
RUN_EVENT_LIMIT=1000
RUN_EVENT_RETENTION_SECONDS=86400
# 阶段 5：有效租约内仅一个 Worker 写入；失效租约由调度器回收。
RUN_LEASE_SECONDS=45
RECOVERY_INTERVAL_SECONDS=5
RUN_MAX_ATTEMPTS=5
# 文件索引独立执行时限（秒），大文件本地 CPU 编码默认最多 30 分钟。
DOCUMENT_INDEX_TIMEOUT_SECONDS=1800
SESSION_SECRET=dev-session-key-not-for-production
SESSION_TTL_SECONDS=28800
# 登录及写操作的来源白名单；生产必须显式设置实际 HTTPS 域名。
AUTH_TRUSTED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:8080","http://localhost:8080","http://127.0.0.1:8000","http://127.0.0.1:18000"]
# JSON 数组；同源代理不需要跨域配置。
CORS_ORIGINS=[]
LOG_LEVEL=INFO
# 指标使用独立令牌；开发留空时指标接口拒绝访问，生产至少32位。
METRICS_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLE_RATIO=0.1
# 可选企业模型 CA；默认验证系统可信证书，不能关闭 TLS 校验。
MODEL_CA_FILE=

# 阶段 4 默认本地 BGE-M3；Windows/Linux 均使用本机模型缓存的绝对路径。
COMPOSE_PROFILES=local-embedding
BGE_MODEL_PATH=./.cache/models/models--BAAI--bge-m3
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_DIMENSION=1024
# 留空即默认本地服务；服务器接口示例 https://embedding.example.com/v1。
# 使用服务器模型时删除 COMPOSE_PROFILES 中的 local-embedding。
# EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=dev-embedding-key
EMBEDDING_TIMEOUT_SECONDS=120

# 七步 RAG；Fast 留空用本地规则，Grader 留空沿用当前回答模型。
# Rerank 端点填写完整 /rerank 地址，默认关闭；生产端点要求 HTTPS。
RAG_TIMEOUT_SECONDS=60
RAG_PARALLEL_QUERIES=4
RAG_FAST_MODEL=
# 角色独立密钥；空时沿用 MODEL_API_KEY，仍共用 MODEL_BASE_URL。
RAG_FAST_API_KEY=
# 图谱独立后台抽取，复用 Fast 模型或默认聊天模型；关闭后保留普通 RAG。
RAG_GRAPH_ENABLED=true
RAG_GRADER_MODEL=
RAG_GRADER_API_KEY=
RAG_CANDIDATE_LIMIT=24
RAG_CONTEXT_CHARACTERS=5000
RAG_MERGE_RATIO=0.5
RAG_HITL_TTL_SECONDS=1800
RAG_RERANK_URL=
RAG_RERANK_MODEL=
RAG_RERANK_API_KEY=
RAG_RERANK_TIMEOUT_SECONDS=3
RAG_RERANK_MAX_CHARACTERS=12000
RAG_RERANK_FAILURE_THRESHOLD=3
RAG_RERANK_COOLDOWN_SECONDS=30

LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
OPENAI_API_KEY=

# Tavily 网页搜索服务端密钥；同时在 TOOL_HTTP_ALLOWED_HOSTS 加入 api.tavily.com
TAVILY_API_KEY=
